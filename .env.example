# Copy this file to .env and fill in real values. .env is gitignored.

# --- LLM (existing, required since Task 1) ---
MODEL_NAME=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
CHROMA_DB=./chroma_db
DOCUMENT_PATH=./seed/docs

# --- LangSmith tracing (Task 5) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=paste-your-langsmith-api-key-here
LANGSMITH_PROJECT=trippilot

# --- Generation eval judge (Task 5) - a DIFFERENT local Ollama model than
# MODEL_NAME, so the judge isn't grading its own homework. Pull it first:
# ollama pull qwen2.5:7b
JUDGE_MODEL_NAME=qwen2.5:7b
