# Copy this file to .env and fill in real values. .env is gitignored.

# --- LLM (existing, required since Task 1) ---
MODEL_NAME=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
CHROMA_DB=./chroma_db
